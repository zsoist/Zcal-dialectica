# ============================================
# BASE DE DATOS (Supabase - GRATIS)
# ============================================
# 1. Ve a https://supabase.com y crea una cuenta gratis
# 2. Crea un nuevo proyecto
# 3. Ve a Settings > Database > Connection string > URI
# 4. Copia el connection string y reemplaza [YOUR-PASSWORD] con tu password
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres"

# ============================================
# GOOGLE OAUTH
# ============================================
# Ya tienes estos de Google Cloud Console
GOOGLE_CLIENT_ID="918895357868-ukuo3pkvtdatg5sldjijcon2hequa8fn.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="tu-client-secret-aqui"

# ============================================
# NEXTAUTH
# ============================================
# URL donde corre tu app
NEXTAUTH_URL="http://localhost:3000"

# Genera un secret con: openssl rand -base64 32
# O usa este sitio: https://generate-secret.vercel.app/32
NEXTAUTH_SECRET="genera-un-secret-aleatorio-aqui"
